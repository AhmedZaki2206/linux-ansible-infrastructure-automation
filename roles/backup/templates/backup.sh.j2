#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

backup_root={{ backup_root | quote }}
timestamp=$(date -u +%Y%m%dT%H%M%SZ)
archive="${backup_root}/$(hostname)-${timestamp}.tar.gz"
checksum="${archive}.sha256"

paths=(
{% for path in backup_paths %}  {{ path | quote }}
{% endfor %}{% if inventory_hostname in groups['web_servers'] %}{% for path in backup_web_paths %}  {{ path | quote }}
{% endfor %}{% endif %})

tar --create --gzip --file "${archive}" --absolute-names "${paths[@]}"
tar --list --gzip --file "${archive}" >/dev/null
sha256sum "${archive}" > "${checksum}"
find "${backup_root}" -type f -mtime +{{ backup_retention_days }} -delete
printf '%s\n' "${archive}"

